# Copiaza in `.env.local` si completeaza. `.env.local` NU se comite.
#
# Niciuna dintre variabile nu are prefix NEXT_PUBLIC_: prefixul le-ar include in
# bundle-ul de browser, iar cheile ar deveni publice.

# Postgres. Local vine din docker-compose; in productie e endpointul RDS.
DATABASE_URI=postgres://almek:almek@localhost:5432/almek

# Sir aleator si lung; semneaza sesiunile din admin. Genereaza cu:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# S3 pentru media. LASA GOL LOCAL — fara ele, Payload scrie in public/media,
# deci nu ai nevoie de credentiale AWS ca sa lucrezi si nu incarci fisiere de
# test in bucketul de productie.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
